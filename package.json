{
  "name": "pausenrechner",
  "version": "1.9.5",
  "description": "Pausenrechner App",
  "main": "main.js",
  "author": "Mev",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "build:dir": "electron-builder --win dir --publish never"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dayjs": "^1.11.9",
    "electron-log": "^5.3.3",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pausenrechner.app",
    "productName": "Pausenrechner",
    "artifactName": "Pausenrechner-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!dist_backup/**",
      "!build/**",
      "!node_modules/.cache/**",
      "!.github/**",
      "!*.bak",
      "!bfg.jar"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mev9999",
        "repo": "Pausenrechner",
        "releaseType": "release"
      }
    ]
  }
}
